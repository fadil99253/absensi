APP_NAME=HadirKu
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:5173
FRONTEND_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
APP_LOCALE=id
APP_FALLBACK_LOCALE=id

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hadirku
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_FOREIGN_KEYS=true

BCRYPT_ROUNDS=12
SANCTUM_EXPIRATION=480
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=absensi@hadirku.id
MAIL_FROM_NAME="${APP_NAME}"

ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_NAME="Administrator HadirKu"
ADMIN_INITIAL_EMAIL=admin@hadirku.id
ADMIN_INITIAL_PASSWORD=
